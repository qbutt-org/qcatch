{
  "name": "qcatch",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "A local-first browser extension for downloading accessible HLS, DASH, audio, and subtitle tracks.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "bridge:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File bridge/build.ps1",
    "check": "bun run typecheck && bun run build",
    "clean": "bun run scripts/clean.ts",
    "icons": "bun run scripts/icons.ts",
    "integration:product-actions": "bun run scripts/integration-product-actions.ts",
    "integration:vk-resolve": "bun run scripts/integration-vk-resolve.ts",
    "package": "bun run scripts/package.ts",
    "release:build": "bun run scripts/release.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@floating-ui/dom": "1.8.0",
    "mediabunny": "1.52.3",
    "preact": "10.27.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/chrome": "0.1.33",
    "@types/node": "24.13.3",
    "fflate": "0.8.3",
    "sharp": "0.34.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "patchedDependencies": {
    "mediabunny@1.52.3": "patches/mediabunny@1.52.3.patch"
  }
}
